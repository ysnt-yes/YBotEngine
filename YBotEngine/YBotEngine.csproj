<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

        <!-- UI -->
        <UiProjectRoot>..\YBotEngine.UI\</UiProjectRoot>
        <SpaRoot>..\YBotEngine.UI\</SpaRoot>
        <SpaProxyServerUrl>http://localhost:5173</SpaProxyServerUrl>
        <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
        <UserSecretsId>61fb24a6-40ad-45d7-af39-2e7a930361ec</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.10" />
        <PackageReference Include="Microsoft.CodeAnalysis.Scripting.Common" Version="5.6.0" />
        <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.11" />
        <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\YBotEngine.Runners.Roslyn\YBotEngine.Runners.Roslyn.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="wwwroot\" />
    </ItemGroup>

    <Target Name="PublishRunWebpack" AfterTargets="ComputeFilesToPublish">
        <Message Importance="high" Text="--- BUILDING SVELTE UI APP ---" />
        <Exec Command="npm install" WorkingDirectory="$(UiProjectRoot)" />
        <Exec Command="npm run build" WorkingDirectory="$(UiProjectRoot)" />

        <ItemGroup>
            <SvelteProductionAssets Include="$(UiProjectRoot)dist\**\*.*" />
        </ItemGroup>

        <Copy SourceFiles="@(SvelteProductionAssets)"
              DestinationFiles="@(SvelteProductionAssets->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />

        <ItemGroup>
            <ResolvedFileToPublish Include="@(SvelteProductionAssets->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')">
                <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>

</Project>
